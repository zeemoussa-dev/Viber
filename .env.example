# Copy to .env and edit. .env is git-ignored. Every value is optional; the defaults suit local development.

# Database password. Set it before the FIRST `docker compose up`: Postgres only reads it when it creates the
# data volume. Changing it later needs the volume's password changed too (see DEPLOY.md).
POSTGRES_PASSWORD=change-me

# Access token for the API, dashboard and MCP. Leave empty only on a machine nobody else can reach.
# Generate one:  [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
VIBER_TOKEN=

# Which address the ports listen on. 127.0.0.1 = this machine only (default).
# 0.0.0.0 = reachable from your network: set VIBER_TOKEN first.
VIBER_BIND=127.0.0.1

# Host ports.
VIBER_PORT=8088
DB_PORT=5433
